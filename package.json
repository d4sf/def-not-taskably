{
  "name": "dnt",
  "version": "1.1.0",
  "description": "A simple CLI for managing tickets",
  "main": "./dist/index.js",
  "types": "./dist/types.d.ts",
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "bin": {
    "dnt": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "cli",
    "task-manager",
    "todo"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^25.7.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
